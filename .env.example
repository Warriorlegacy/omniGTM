# Signhify Content Autopilot - Environment Variables
# Copy this file to .env and fill in your values

# AI Providers (free tiers available)
# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Google Gemini (generous free tier)
GEMINI_API_KEY=

# Preferred AI provider (openai, anthropic, gemini)
AI_PROVIDER=gemini

# Social Platform APIs (optional - enables auto-posting)
# Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# LinkedIn API (limited free access)
LINKEDIN_ACCESS_TOKEN=

# Twitter/X API (free tier has write limits)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# YouTube Data API
YOUTUBE_API_KEY=

# Content settings
CONTENT_TOPICS=ai,agents,automation,growth,marketing,software-engineering
CONTENT_TONE=educational,authentic,practical
TARGET_AUDIENCE=indie-hackers,developers,ai-enthusiasts,founders

# Brand settings
BRAND_NAME=Signhify Studio
BRAND_VOICE=technical-but-accessible, honest, helpful, no-hype
BRAND_COLORS=gradient-purple, modern, minimal
